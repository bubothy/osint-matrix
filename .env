# ═══════════════════════════════════════════════════════════════════════════
#  OSINT MATRIX — configuration
#  Rename this file to  .env  and fill in the values.
#  Anything marked OPTIONAL can stay blank; the command that needs it will
#  print setup instructions instead of failing.
# ═══════════════════════════════════════════════════════════════════════════

# ── REQUIRED ───────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications  →  Bot  →  Reset Token
DISCORD_TOKEN=MTU3MDg5NDExMTgxOTY5ODIzNw.GfG_ej.fD7OoFksZSR0gl8oIUnmxheMx1973VUHMk9TuI

# Your own Discord user ID (right-click your name → Copy User ID with Developer Mode on).
# Multiple owners: 111111111111111111,222222222222222222
# Owners always bypass the approval gate and can run every admin command.
OWNER_IDS=1012558291567640586

# ── ACCESS CONTROL ─────────────────────────────────────────────────────────
# Prefix used for text commands. Slash commands are also available.
COMMAND_PREFIX=-

# Put your private server ID here to sync slash commands instantly.
# Leave blank to sync globally (Discord can take up to an hour to show them).
GUILD_ID=1570895070029414581

# Channel that receives an audit line for every lookup and admin action.
# Leave blank to disable the live audit feed (the database log still records it).
LOG_CHANNEL_ID=1570895129164783737

# Allow approved users to run commands in DMs as well as in the server.
ALLOW_DMS=true

# Start in maintenance mode: only owners can use the bot. Can be toggled at
# runtime with the  .maintenance  command.
MAINTENANCE=false

# ── NETWORK / PERFORMANCE ──────────────────────────────────────────────────
HTTP_TIMEOUT=15
CACHE_TTL=300
MAX_CONCURRENCY=4
MAX_RESULTS=25

# ── OPTIONAL API KEYS ──────────────────────────────────────────────────────
# Every one of these is free to obtain. Blank = feature degrades gracefully.

# https://github.com/settings/tokens  (classic token, no scopes needed)
# 60 req/h → 5,000 req/h for GitHub lookups.
GITHUB_TOKEN=

# https://haveibeenpwned.com/API/Key  (paid, ~$3.95/mo)
# Email breach history.  Password checks work WITHOUT a key.
HIBP_API_KEY=

# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=0615dd5a8340456c0c29d92a2bf89f562c0fd0ed6a0aa162a0d2b6b5cdefd204

# https://account.shodan.io
SHODAN_API_KEY=

# https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=7f7b704dda4e4726fb4f65847abb9050facbd27e91b1685981b66b91855b1a59fd29c04e037e9988

# https://urlscan.io/user/apikey
URLSCAN_API_KEY=01a1d699-7b90-75c8-a4b7-de4b7e31c452

# https://auth.abuse.ch/   (required by abuse.ch since 2023)
ABUSECH_AUTH_KEY=347a1f8d37ba4ba5094d6e9bffa483bb9d786b43a5b614dd

# https://nvd.nist.gov/developers/request-an-api-key
# Raises NVD limits from 5 to 50 requests / 30 s.
NVD_API_KEY=

# https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
